# =============================================================================
# Agent ENV (agent/.env)
# Copy file này thành agent/.env rồi điền giá trị thật.
# .env KHÔNG được commit (đã có trong .gitignore root).
# Production build (pkg): inject qua process env lúc start, hoặc file ~/.9remote/.env
# =============================================================================

# --- Auth (dùng chung APP_SECRET với web .dev.vars) ---
APP_SECRET="REPLACE_WITH_openssl_rand_hex_32"

# Salt để hash machineId
MACHINE_ID_SALT="REPLACE_WITH_openssl_rand_hex_16"

# --- Optional ---
# Override default bind address (mặc định 127.0.0.1 sau fix)
# AGENT_BIND_HOST="127.0.0.1"
# AGENT_PORT="2208"

# CORS allowlist (comma-separated). Mặc định domain prod.
# AGENT_CORS_ORIGINS="https://9remote.cc,https://dev.9remote.cc,http://localhost:3000"
