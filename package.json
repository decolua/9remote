{
  "name": "9remote-monorepo",
  "version": "2.5.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "agent",
    "web",
    "gitbook",
    "desktop"
  ],
  "scripts": {
    "dev": "run-p agent:dev web:dev",
    "agent:dev": "NODE_ENV=development node agent/cli/index.js",
    "agent:dev:ui": "NODE_ENV=development node agent/cli/index.js ui",
    "agent:build": "node scripts/syncVersion.js && node scripts/buildPkg.js",
    "agent:publish": "npm run agent:build && cd agent && npm publish",
    "agent:build:beta": "NREMOTE_PKG=9remote-beta npm run agent:build",
    "agent:publish:beta": "rm -f 9remote-beta-*.tgz && NREMOTE_PKG=9remote-beta npm run agent:build && npm publish --workspaces=false --access=public 9remote-beta-*.tgz",
    "web:dev": "npm run dev --workspace=web",
    "web:deploy": "npm run deploy --workspace=web",
    "web:deploy:dev": "npm run secrets:sync:dev && npm run deploy --workspace=web -- --env dev",
    "secrets:sync": "node scripts/syncSecrets.mjs",
    "secrets:sync:prod": "node scripts/syncSecrets.mjs --env=production",
    "secrets:sync:dev": "node scripts/syncSecrets.mjs --env=dev",
    "expo:dev": "npm start --prefix expo",
    "expo:ios": "npm run ios --prefix expo",
    "expo:android": "npm run android --prefix expo",
    "docs:dev": "npm run dev --workspace=gitbook",
    "docs:deploy": "npm run build --workspace=gitbook && cd gitbook && npx wrangler pages deploy out --project-name=9remote-docs",
    "pc:dev": "run-p agent:dev:ui:start pc:tauri",
    "pc:tauri": "NINEREMOTE_ENV=development npm run tauri dev --prefix desktop",
    "pc:build": "bash desktop/scripts/build-macos-signed.sh --target universal-apple-darwin",
    "agent:dev:ui:start": "npm run dev:ui:start --prefix agent",
    "pc:build:win": "bash desktop/scripts/build-windows.sh",
    "pc:build:linux": "bash desktop/scripts/build-linux.sh",
    "pc:build:linux:amd64": "bash desktop/scripts/build-linux.sh --amd64"
  },
  "devDependencies": {
    "@napi-rs/image": "^1.12.0",
    "@tauri-apps/cli": "^2.5.0",
    "esbuild": "^0.27.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "javascript-obfuscator": "^5.4.1",
    "koffi": "^2.16.1",
    "node-screenshots": "^0.2.8",
    "node-windows": "^1.0.0-beta.8",
    "npm-run-all": "^4.1.5",
    "screenshot-desktop": "^1.15.3",
    "xxhash-addon": "^2.1.0"
  },
  "dependencies": {
    "9remote": "^2.0.34",
    "wrangler": "^4.73.0"
  }
}
