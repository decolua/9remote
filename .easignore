# Excluded from the EAS Build upload tarball (repo root — EAS clones from here).
# .codegraph holds a unix socket, which makes the archive step fail with EINVAL.
.codegraph/

# Workspaces the mobile build never needs
host/
web/
gitbook/
desktop/
benchmark/
9remote_public/

# Local scratch/caches — large and irrelevant to the build
.source/
.bin/
.seeding/
.cursor/
.git/
.docs/
.devloop/
.handoff/
.win/
.release/
*.tgz

# Local prebuild output — EAS regenerates native projects from app.json.
# Shipping it makes EAS read stale native config instead (921 MB, gitignored).
expo/ios/
expo/android/

expo/keys/
expo/fastlane/

# Secrets (R2 creds, OTA tokens) must never ship in the tarball.
# .easignore replaces .gitignore for the whole tree, so these need list here.
expo/.env*

# Build output and Metro cache, regenerated by EAS or scripts.
expo/dist/
expo/.expo/

node_modules/
