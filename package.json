{
  "name": "9remote-monorepo",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "workspaces": [
    "cli",
    "server",
    "client",
    "worker"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:cli dev:client",
    "dev:cli": "node cli/index.js --auto",
    "dev:client": "npm run dev --workspace=client",
    "start": "node cli/index.js",
    "build:pkg": "node scripts/syncVersion.js && node scripts/buildPkg.js",
    "build:worker": "npm run build --workspace=client && node scripts/buildWorkerStatic.js",
    "deploy": "npm run build:worker && cd worker && wrangler deploy",
    "publish": "npm run build:pkg && cd cli && npm publish"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "npm-run-all": "^4.1.5"
  }
}
