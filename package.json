{
  "name": "9remote-monorepo",
  "version": "3.0.30",
  "private": true,
  "type": "module",
  "workspaces": [
    "host",
    "web",
    "gitbook",
    "desktop"
  ],
  "scripts": {
    "host:dev": "NODE_ENV=development node host/cli/index.js",
    "host:build": "node scripts/syncVersion.js && node scripts/buildPkg.js",
    "host:sync": "node scripts/syncVersion.js && NO_PACK=1 node scripts/buildPkg.js && node scripts/syncLocalAgent.mjs",
    "host:publish": "npm run host:build && cd host && npm publish",
    "host:publish:local": "npm run host:build && cd host && npm publish --registry http://localhost:4873",
    "web:dev": "npm run dev --workspace=web",
    "web:deploy": "npm run deploy --workspace=web",
    "web:deploy:dev": "npm run deploy:dev --workspace=web",
    "pc:dev": "run-p _host:start _pc:tauri",
    "pc:build": "bash desktop/scripts/build-macos-signed.sh --target universal-apple-darwin && bash desktop/scripts/build-windows.sh",
    "docs:dev": "npm run dev --workspace=gitbook",
    "docs:deploy": "npm run build --workspace=gitbook && cd gitbook && npx wrangler pages deploy out --project-name=9remote-docs",
    "_pc:tauri": "NINEREMOTE_ENV=development npm run tauri dev --prefix desktop",
    "_host:start": "npm run dev:ui:start --prefix host"
  },
  "devDependencies": {
    "@napi-rs/image": "^1.12.0",
    "@tauri-apps/cli": "^2.5.0",
    "esbuild": "^0.27.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "koffi": "^2.16.1",
    "node-screenshots": "^0.2.8",
    "node-windows": "^1.0.0-beta.8",
    "npm-run-all": "^4.1.5",
    "screenshot-desktop": "^1.15.3",
    "xxhash-addon": "^2.1.0"
  },
  "dependencies": {
    "9remote": "^2.0.34",
    "wrangler": "^4.73.0"
  }
}
