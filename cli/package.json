{
  "name": "9remote",
  "version": "0.1.37",
  "type": "module",
  "description": "Remote terminal access from anywhere",
  "main": "index.js",
  "bin": {
    "9remote": "./dist/cli.cjs"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js --auto",
    "build": "node ../scripts/buildPkg.js",
    "postinstall": "node scripts/install.js || true"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "inquirer": "^9.3.8",
    "qrcode-terminal": "^0.12.0",
    "node-machine-id": "^1.1.12",
    "ora": "^8.1.1",
    "socket.io": "^4.8.3",
    "http-proxy": "^1.18.1"
  },
  "optionalDependencies": {
    "node-pty": "^1.2.0-beta.7",
    "@hurdlegroup/robotjs": "^0.12.1",
    "sharp": "^0.33.5"
  },
  "files": [
    "dist/",
    "utils/",
    "scripts/"
  ],
  "keywords": [
    "remote",
    "terminal",
    "ssh",
    "cli"
  ],
  "license": "MIT"
}
