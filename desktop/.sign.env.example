# Copy this file to .sign.env and fill in your Apple Developer credentials.
# NEVER commit .sign.env — it is gitignored.

# Certificate name as shown in Keychain Access.
# Format: "Developer ID Application: Your Name (TEAMID)"
APPLE_SIGNING_IDENTITY=

# Apple ID used for notarization (the developer account email).
APPLE_ID=

# App-specific password for notarization.
# Create at https://appleid.apple.com → Sign-In & Security → App-Specific Passwords.
# This is NOT your iCloud password.
APPLE_PASSWORD=

# Team ID (10 chars). Found in https://developer.apple.com/account → Membership Details.
APPLE_TEAM_ID=
