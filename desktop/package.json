{
  "name": "9remote-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "9Remote desktop shell",
  "author": "9Remote",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "tauri": "tauri",
    "electron": "electron .",
    "electron:dev": "NINEREMOTE_ENV=development electron .",
    "electron:build": "electron-builder --mac",
    "electron:build:dir": "electron-builder --mac --dir"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "electron": "41.10.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cc.9remote.desktop",
    "productName": "9Remote",
    "electronVersion": "41.10.3",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "src-tauri/icons"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "src-tauri/icons/trayIcon.png"
    ],
    "extraResources": [
      {
        "from": "node_modules/npm",
        "to": "npm"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "src-tauri/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "notarize": false,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "dmg": {
      "title": "9Remote"
    }
  },
  "dependencies": {
    "npm": "^12.0.2"
  }
}
