{
  "$schema": "../node_modules/@tauri-apps/cli/schema/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for 9Remote desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-spawn",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text"
  ]
}
