{
  "name": "9remote",
  "version": "2.5.8",
  "type": "module",
  "description": "Remote terminal access from anywhere",
  "main": "dist/server.cjs",
  "bin": {
    "9remote": "./dist/cli.cjs"
  },
  "scripts": {
    "start": "node cli/index.js",
    "ui": "node cli/index.js ui",
    "dev": "NODE_ENV=development nodemon cli/index.js",
    "dev:ui": "npm-run-all --parallel dev:ui:run dev:vite:wait",
    "dev:vite": "vite",
    "dev:vite:wait": "wait-on http://localhost:2208/api/health && vite",
    "dev:ui:run": "NODE_ENV=development node cli/index.js ui",
    "dev:ui:start": "npm-run-all --parallel dev:ui:run:start dev:vite:wait",
    "dev:ui:run:start": "NODE_ENV=development node cli/index.js ui --start",
    "build:ui": "vite build",
    "postinstall": "node dist/install.cjs || true"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "remote",
    "terminal",
    "ssh",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "archiver": "^5.3.2",
    "bufferutil": "4.1.0",
    "chalk": "^5.4.1",
    "chokidar": "^3.6.0",
    "edge-tts-node": "^1.5.7",
    "http-proxy": "^1.18.1",
    "inquirer": "^9.3.8",
    "koffi": "^2.16.3",
    "multicast-dns": "^7.2.5",
    "node-machine-id": "^1.1.12",
    "node-screenshots": "^0.2.8",
    "ora": "^8.1.1",
    "preact": "^10.26.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "0.33.5",
    "socket.io": "^4.8.3",
    "utf-8-validate": "6.0.6",
    "https-proxy-agent": "^7.0.0",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "@hurdlegroup/robotjs": "^0.12.1",
    "@julusian/jpeg-turbo": "^3.0.1",
    "node-datachannel": "0.32.3",
    "node-pty": "1.2.0-beta.12"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.5",
    "autoprefixer": "^10.4.21",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.2",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "wait-on": "^9.0.4"
  }
}
