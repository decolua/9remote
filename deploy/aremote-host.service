[Unit]
Description=ARemote Host reverse relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ARemote
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node host/aremote/index.js start
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
