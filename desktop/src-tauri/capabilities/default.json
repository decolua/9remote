[
  {
    "$schema": "../node_modules/@tauri-apps/cli/schema/desktop-schema.json",
    "identifier": "default",
    "description": "Default capabilities for 9Remote desktop app",
    "windows": ["main"],
    "permissions": [
      "core:default",
      "clipboard-manager:allow-write-text",
      "clipboard-manager:allow-read-text",
      "opener:default",
      "notification:default"
    ]
  },
  {
    "$schema": "../node_modules/@tauri-apps/cli/schema/desktop-schema.json",
    "identifier": "local-agent-pages",
    "description": "The localhost agent pages (dashboard + embedded workspace) may sync the native window title, theme, and notifications",
    "windows": ["main"],
    "remote": { "urls": ["http://localhost:2208", "http://127.0.0.1:2208"] },
    "permissions": [
      "core:window:allow-set-title",
      "core:window:allow-set-theme",
      "core:window:allow-set-background-color",
      "core:window:allow-set-badge-count",
      "notification:default"
    ]
  }
]
